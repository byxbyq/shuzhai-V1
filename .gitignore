DELIVERY/
test_screenshots/

# Trae/Workbuddy IDE 记忆文件（本地会话状态）
.workbuddy/

# 运行时配置/状态（每次启动会变更，不入版本控制）
data/last_project.txt
data/ai_config.json
data/ranking/*.json
backend/flow_engine/nodes/config_nodes.json
backend/flow_engine/nodes/workflows.json
backend/flow_engine/test_v2_output.txt

# 临时调试/验证脚本（不纳入版本控制，单下划线前缀；不影响 __init__.py）
_*.py
!__init__.py
_*.json
_*.txt
_*.bat

# APK副本目录暂不规划，禁止触碰与同步（不纳入版本控制）
apk/android/app/src/main/python/

